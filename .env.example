# Copy this file to .env and fill in your own values. Never commit .env.

GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_garmin_password

# Name shown in the dashboard greeting.
USER_NAME=Your Name

# Used by dashboard.py to estimate BMR (Mifflin-St Jeor) for the Calories
# card subtext, since garmin_daily only stores a single total-calories value.
BIO_AGE=30
BIO_SEX=male
BIO_WEIGHT_LB=170
BIO_HEIGHT_IN=69

# Google Calendar week view (optional). In Google Calendar: Settings ->
# [your calendar] -> "Integrate calendar" -> copy the "Secret address in
# iCal format" and paste it here. To pull from several calendars, separate
# their URLs with commas. Local .ics file paths also work. Each calendar is
# auto-named (from the file) and color-coded in the dashboard.
# GCAL_ICS_URL=https://calendar.google.com/.../work/basic.ics,https://calendar.google.com/.../personal/basic.ics
GCAL_ICS_URL=
